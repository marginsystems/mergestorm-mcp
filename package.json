{
  "name": "mergestorm-mcp",
  "version": "0.2.28",
  "description": "Mergestorm MCP server — identity, review, and read-only stack tools over stdio",
  "license": "MIT",
  "type": "module",
  "author": "Margin Systems <hello@mergestorm.ai>",
  "keywords": [
    "mergestorm",
    "mcp",
    "code-review"
  ],
  "bin": {
    "mergestorm-mcp": "./dist/index.js"
  },
  "exports": {
    "./hosted": {
      "mergestorm-source": "./src/hosted.ts",
      "types": "./dist/lib/hosted.d.ts",
      "default": "./dist/lib/hosted.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/.build-inputs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external --banner:js=\"#!/usr/bin/env node\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mergestorm": "0.3.64",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marginsystems/mergestorm-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/marginsystems/mergestorm-mcp/issues"
  },
  "homepage": "https://github.com/marginsystems/mergestorm-mcp"
}
